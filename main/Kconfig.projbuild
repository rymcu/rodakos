menu "RodakOS voice processing"

config USE_DEVICE_AEC
    bool "Use ESP-SR device AEC"
    default y
    help
        Run echo cancellation on the BigSmart device before uplink.

config USE_SERVER_AEC
    bool "Use timestamped server AEC"
    default n
    depends on !USE_DEVICE_AEC

config RODAKOS_WAKE_AEC
    bool "Cancel speaker echo before local wake detection"
    default y
    help
        Runs ESP-SR AEC against the ES8311 loopback (MIC3) in front of MultiNet, so the
        wake word can be heard while music plays.

config RODAKOS_WAKE_AGC
    bool "Apply automatic gain before local wake detection"
    default y
    help
        Runs ESP-SR WebRTC AGC in front of MultiNet so quiet, distant speech reaches
        the level MultiNet was trained on.

config RODAKOS_WAKE_CHIME
    bool "Play a short chime when the wake word is accepted"
    default y
    help
        Confirms a local wake immediately, before the cloud session is ready.
        The chime overlaps WebSocket setup instead of adding to it.

endmenu
