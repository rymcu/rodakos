{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rymcu.com/schemas/rodak-aiot/v1/inbox-action-request.schema.json",
  "title": "Message center action (body of POST /api/v1/aiot/devices/inbox/actions)",
  "description": "Draft. opId is generated by the device and reused for a retry of the same request, so the server applies it at most once and returns the first outcome for a repeated opId of the same binding. expectedRevision is the record revision the device showed.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "opId",
    "action",
    "noticeId",
    "expectedRevision"
  ],
  "properties": {
    "opId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[!-~]+$"
    },
    "action": {
      "enum": [
        "read",
        "complete",
        "snooze"
      ]
    },
    "noticeId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[!-~]+$"
    },
    "expectedRevision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "taskId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[!-~]+$"
    },
    "occurrenceId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[!-~]+$"
    },
    "snoozeMinutes": {
      "enum": [
        10,
        30,
        60
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "action": {
            "const": "complete"
          }
        },
        "required": [
          "action"
        ]
      },
      "then": {
        "required": [
          "taskId"
        ],
        "not": {
          "anyOf": [
            {
              "required": [
                "occurrenceId"
              ]
            },
            {
              "required": [
                "snoozeMinutes"
              ]
            }
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "action": {
            "const": "snooze"
          }
        },
        "required": [
          "action"
        ]
      },
      "then": {
        "required": [
          "occurrenceId",
          "snoozeMinutes"
        ],
        "not": {
          "required": [
            "taskId"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "action": {
            "const": "read"
          }
        },
        "required": [
          "action"
        ]
      },
      "then": {
        "not": {
          "anyOf": [
            {
              "required": [
                "taskId"
              ]
            },
            {
              "required": [
                "occurrenceId"
              ]
            },
            {
              "required": [
                "snoozeMinutes"
              ]
            }
          ]
        }
      }
    }
  ]
}
