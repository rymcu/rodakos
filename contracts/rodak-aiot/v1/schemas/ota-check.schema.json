{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rymcu.com/schemas/rodak-aiot/v1/ota-check.schema.json",
  "title": "GET /api/v1/ota/check data",
  "description": "GET /api/v1/ota/check data.",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "upgradeAvailable": {
          "const": false
        }
      },
      "required": [
        "upgradeAvailable"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "upgradeAvailable": {
          "const": true
        },
        "taskNo": {
          "type": "string",
          "pattern": "^ota_[0-9]{13}_[0-9a-f]{8}$",
          "description": "OTA task number: ota_<epoch-ms>_<8 hex>."
        },
        "packageCode": {
          "type": "string"
        },
        "fromVersion": {
          "type": "string"
        },
        "toVersion": {
          "type": "string"
        }
      },
      "required": [
        "upgradeAvailable",
        "taskNo",
        "packageCode",
        "fromVersion",
        "toVersion"
      ]
    }
  ]
}
