{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rymcu.com/schemas/rodak-realtime-voice/v1/error.schema.json",
  "title": "error (server -> device)",
  "description": "Server error. sessionId is optional. retryable true makes an established interaction eligible for bounded reconnect.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "event": {
      "const": "error"
    },
    "code": {
      "type": "string",
      "minLength": 1
    },
    "message": {
      "type": "string",
      "minLength": 1
    },
    "retryable": {
      "type": "boolean"
    },
    "sessionId": {
      "type": "string",
      "minLength": 1,
      "x-nonblankAfterTrim": true
    }
  },
  "required": [
    "event",
    "code",
    "message",
    "retryable"
  ]
}
