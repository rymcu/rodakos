{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rymcu.com/schemas/rodak-realtime-voice/v1/playback-abort.schema.json",
  "title": "playback.abort (device -> server)",
  "description": "RodakOS emits these three reasons. Rodak accepts any non-empty reason.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "event": {
      "const": "playback.abort"
    },
    "sessionId": {
      "type": "string",
      "minLength": 1,
      "x-nonblankAfterTrim": true
    },
    "reason": {
      "enum": [
        "user",
        "wake-word",
        "vad_detected"
      ]
    },
    "playbackEpoch": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4294967295
    }
  },
  "required": [
    "event",
    "sessionId",
    "reason"
  ]
}
