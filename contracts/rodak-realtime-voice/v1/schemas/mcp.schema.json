{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rymcu.com/schemas/rodak-realtime-voice/v1/mcp.schema.json",
  "title": "mcp (either direction)",
  "description": "payload must be a JSON object. RodakOS advertises features.mcp false, validates the envelope and discards it.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "event": {
      "const": "mcp"
    },
    "sessionId": {
      "type": "string",
      "minLength": 1,
      "x-nonblankAfterTrim": true
    },
    "payload": {
      "type": "object"
    }
  },
  "required": [
    "event",
    "sessionId",
    "payload"
  ]
}
