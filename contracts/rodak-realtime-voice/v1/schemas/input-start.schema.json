{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rymcu.com/schemas/rodak-realtime-voice/v1/input-start.schema.json",
  "title": "input.start (device -> server)",
  "description": "Starts an input turn. The first turn after wake.detected uses mode realtime. Later turns reuse the session.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "event": {
      "const": "input.start"
    },
    "sessionId": {
      "type": "string",
      "minLength": 1,
      "x-nonblankAfterTrim": true
    },
    "mode": {
      "enum": [
        "auto-stop",
        "manual-stop",
        "realtime"
      ]
    }
  },
  "required": [
    "event",
    "sessionId"
  ]
}
