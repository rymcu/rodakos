{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rymcu.com/schemas/rodak-realtime-voice/v1/wake-detected.schema.json",
  "title": "wake.detected (device -> server)",
  "description": "Sent once per session, before the first input.start. text is the configured wake phrase.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "event": {
      "const": "wake.detected"
    },
    "sessionId": {
      "type": "string",
      "minLength": 1,
      "x-nonblankAfterTrim": true
    },
    "text": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "event",
    "sessionId",
    "text"
  ]
}
