{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rymcu.com/schemas/rodak-realtime-voice/v1/input-stop.schema.json",
  "title": "input.stop (device -> server)",
  "description": "Ends an input turn.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "event": {
      "const": "input.stop"
    },
    "sessionId": {
      "type": "string",
      "minLength": 1,
      "x-nonblankAfterTrim": true
    },
    "reason": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "event",
    "sessionId"
  ]
}
